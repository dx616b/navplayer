<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".ui.MainActivity">

    <TextView
        android:id="@+id/playlistsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/playlists"
        android:textAllCaps="true"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:letterSpacing="0.05"
        app:layout_constraintBottom_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/topBar" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/touch_target_min"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/randomButton"
            style="@style/Widget.NavPlayer.RandomButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="@string/random" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:focusable="true"
            android:padding="@dimen/transport_icon_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            app:tint="@color/on_surface" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/playlistList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:overScrollMode="never"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toTopOf="@id/playerBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        tools:listitem="@layout/item_playlist" />

    <ProgressBar
        android:id="@+id/loadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/playlistList"
        app:layout_constraintEnd_toEndOf="@id/playlistList"
        app:layout_constraintStart_toStartOf="@id/playlistList"
        app:layout_constraintTop_toTopOf="@id/playlistList" />

    <LinearLayout
        android:id="@+id/playerBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="@dimen/player_bar_min_height"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/coverArt"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/cover_art"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_cover_placeholder" />

        <LinearLayout
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/trackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Song title" />

            <TextView
                android:id="@+id/trackArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="11sp"
                tools:text="Artist" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/preButton"
            android:layout_width="@dimen/touch_target_transport"
            android:layout_height="@dimen/touch_target_transport"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/previous"
            android:focusable="true"
            android:padding="@dimen/transport_icon_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_previous"
            app:tint="@color/on_surface" />

        <ImageButton
            android:id="@+id/playPauseButton"
            android:layout_width="@dimen/touch_target_play"
            android:layout_height="@dimen/touch_target_play"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/play_pause"
            android:focusable="true"
            android:padding="@dimen/play_icon_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play"
            app:tint="@color/primary" />

        <ImageButton
            android:id="@+id/nextButton"
            android:layout_width="@dimen/touch_target_transport"
            android:layout_height="@dimen/touch_target_transport"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next"
            android:focusable="true"
            android:padding="@dimen/transport_icon_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_next"
            app:tint="@color/on_surface" />

        <SeekBar
            android:id="@+id/seekBar"
            style="@style/Widget.NavPlayer.SeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/positionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="32dp"
            android:textColor="@color/muted"
            android:textSize="11sp"
            tools:text="0:00" />

        <TextView
            android:id="@+id/durationText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="11sp"
            tools:text="/ 4:05" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
