<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    android:background="@drawable/bg_list_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/playlist_row_min_height"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/playlistArt"
        android:layout_width="@dimen/cover_art_playlist"
        android:layout_height="@dimen/cover_art_playlist"
        android:contentDescription="@string/playlist_art"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_cover_placeholder" />

    <TextView
        android:id="@+id/playlistName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/on_surface"
        android:textSize="15sp"
        tools:text="Road trip mix" />
</LinearLayout>
