<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Head-unit UI is always dark; DayNight was applying light Material text on #121212. -->
    <style name="Theme.NavPlayer" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorOnBackground">@color/on_surface</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.NavPlayer.ActionButton</item>
        <item name="textInputStyle">@style/Widget.NavPlayer.TextInputLayout</item>
        <item name="switchStyle">@style/Widget.NavPlayer.Switch</item>
    </style>

    <style name="Widget.NavPlayer.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="boxBackgroundColor">@color/surface</item>
    </style>

    <style name="Widget.NavPlayer.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="Widget.NavPlayer.RandomButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="icon">@drawable/ic_shuffle</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconTint">@color/on_primary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/on_surface</item>
    </style>

    <style name="Widget.NavPlayer.CompactButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
    </style>

    <style name="Widget.NavPlayer.ActionButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="strokeColor">@color/muted</item>
        <item name="rippleColor">@color/primary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.NavPlayer.SettingsButton" parent="Widget.NavPlayer.ActionButton">
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Widget.NavPlayer.SeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.NavPlayer.SeekBar.Driving" parent="Widget.NavPlayer.SeekBar">
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>
</resources>
